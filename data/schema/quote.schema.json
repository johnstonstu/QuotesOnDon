{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quotesondon.com/schema/quote.schema.json",
  "title": "Quote",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "speaker", "tags", "sources", "confidence", "status", "addedAt", "addedBy"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug, unique across data/quotes. Also the URL segment."
    },
    "text": { "type": "string", "minLength": 2, "maxLength": 600 },
    "speaker": { "type": "string", "minLength": 2, "maxLength": 120 },
    "spokenOn": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the words were said, not the date they were published. Null when unknown."
    },
    "context": {
      "type": ["string", "null"],
      "maxLength": 240,
      "description": "Where it was said: venue, programme, platform, occasion."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Every quote must cite at least one retrievable source. Primary first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "type"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 200 },
          "url": { "type": "string", "pattern": "^https?://" },
          "type": {
            "type": "string",
            "enum": ["primary", "secondary", "reference"],
            "description": "primary = transcript/recording of the words themselves; secondary = report quoting them; reference = encyclopaedic/aggregator."
          },
          "accessedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "excerpt": {
            "type": ["string", "null"],
            "maxLength": 400,
            "description": "Verbatim supporting text captured at ingest time, so the claim stays checkable after the source rots."
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["primary", "secondary", "widely-reported", "disputed"],
      "description": "primary = we hold the transcript/recording; widely-reported = common attribution without a located primary source."
    },
    "status": {
      "type": "string",
      "enum": ["published", "draft", "retracted"]
    },
    "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "addedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
    "notes": { "type": ["string", "null"], "maxLength": 600 }
  }
}