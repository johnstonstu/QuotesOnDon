---
import { confidenceLabel, type Quote } from '../lib/quotes';

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
const source = quote.sources[0];
const badgeClass = quote.confidence;
---

<figure class="quote-stage">
  <span class="quote-mark" aria-hidden="true">&ldquo;</span>
  <div class="quote-body">
    <blockquote class="quote-text" data-quote-text>{quote.text}</blockquote>
    <figcaption class="quote-attrib">
      <span class="dash" aria-hidden="true">&mdash;</span>{' '}<span data-quote-speaker>{quote.speaker}</span>{source && (
        <a class="source" href={source.url} rel="noopener nofollow">, {source.label}</a>
      )}
    </figcaption>
    {quote.context && <p class="quote-context">{quote.context}{quote.spokenOn && <> · {quote.spokenOn}</>}</p>}
    <p>
      <span class={`badge ${badgeClass}`} title={confidenceLabel[quote.confidence]}>
        <span class="dot" aria-hidden="true"></span>
        {confidenceLabel[quote.confidence]}
      </span>
    </p>
  </div>
  <span class="quote-mark closing" aria-hidden="true">&rdquo;</span>
</figure>